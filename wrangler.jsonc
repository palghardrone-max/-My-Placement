{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-placement",
  "compatibility_date": "2026-03-15",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "my-placement-production",
      "database_id": "local-dev-db"
    }
  ]
}
